# PASOPATI Environment Configuration Template
# Copy this file to .env for local custom setups
# JANGAN isi nilai asli di file ini — gunakan hanya placeholder.

# ===== AI Provider (opsional; tanpa key sistem memakai rule-based engine) =====
# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
# Base URL OpenAI-compatible (mis. https://api.experientiallabs.ai/v1).
# Kosongkan untuk memakai endpoint Google Gemini resmi.
GEMINI_BASE_URL=
# Nama model. Boleh diikuti komentar inline (# ...).
# Jika memakai provider OpenAI-compatible (mis. Experensial Labs), isi juga
# GEMINI_BASE_URL dan pakai nama model persis seperti di GET {base}/models.
AI_MODEL_NAME=gemini-2.5-flash
# Model untuk mode "Local AI" di app.py (endpoint Ollama/vLLM OpenAI-compatible).
LOCAL_AI_MODEL=llama3

# ===== Telemetri & kontrol plane =====
# HMAC Telemetry Shared Secret (dipakai pasopati_audit.py --push-url).
# WAJIB diganti dengan nilai acak unik per deployment (min 32 karakter).
HMAC_SECRET=replace_with_your_random_secret_min32chars

# Operational API Key (X-Pasopati-API-Key) untuk /api/scan-host, /api/quarantine,
# /api/remediation-*, /api/audit-logs, /api/analyze-threats & /api/download/project-zip.
# WAJIB diganti dengan nilai acak unik per deployment (min 32 karakter).
# Tanpa key ini, endpoint operasional mengembalikan 503 (fail-closed).
PASOPATI_API_KEY=replace_with_your_random_opsec_key_min32chars

# ===== Opsional =====
# Password otorisasi tombol unduh di Field Console Streamlit (app.py).
# Kosong = tombol unduh Streamlit dinonaktifkan.
# PASOPATI_DOWNLOAD_PASSWORD=
# Port HTTP server (default 3000)
# PORT=3000
# Aktifkan hanya bila di belakang reverse proxy tepercaya (1 = satu hop)
# TRUST_PROXY=1
# Folder state (default ./data)
# PASOPATI_DATA_DIR=./data
# Masa berlaku token approval remediasi (ms, default 600000 = 10 menit)
# REMEDIATION_TOKEN_TTL_MS=600000
# Batas waktu pengiriman evidence setelah approval (ms, default 3600000)
# REMEDIATION_EVIDENCE_GRACE_MS=3600000

# Firebase: DIHAPUS 08 Nov 2026 (dep tidak dipakai, rawan vuln). Jangan tambahkan kembali.

{
  "name": "pasopati",
  "private": true,
  "version": "2.9.6",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && node node_modules/eslint/bin/eslint.js .",
    "test:smoke": "node tests/control-plane-smoke.mjs",
    "test:auth": "node tests/auth-session-smoke.mjs",
    "test:endpoints": "node tests/endpoint-registry-smoke.mjs",
    "test:endpoint-health-audit": "node tests/endpoint-health-audit-smoke.mjs",
    "test:expiry": "node tests/remediation-expiry.mjs",
    "test:agent": "node scripts/run-python.mjs tests/test_agent_remediation.py",
    "test:scripts": "tsx tests/scripts-coverage.ts",
    "test:app": "node scripts/run-python.mjs tests/test_app_scripts.py",
    "test:atomic": "node --import tsx tests/atomic-write.mjs",
    "test:elevation": "node tests/elevation-real.mjs",
    "test": "npm run lint && npm run test:smoke && npm run test:auth && npm run test:endpoints && npm run test:endpoint-health-audit && npm run test:expiry && npm run test:atomic && npm run test:agent && npm run test:scripts && npm run test:app && npm run test:redaction && npm run test:elevation",
    "test:redaction": "tsx tests/redaction.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "MIT",
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
